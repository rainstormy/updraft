{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@rainstormy/updraft",
	"version": "1.2.0",
	"description": "Updraft updates changelogs and bumps version numbers when you are about to release a new version of your project.",
	"keywords": [
		"automation",
		"changelog",
		"package",
		"publish",
		"release",
		"semantic",
		"semver",
		"update",
		"upgrade",
		"version"
	],
	"bugs": "https://github.com/rainstormy/updraft/issues",
	"license": "MIT",
	"author": "Steffen Diswal",
	"repository": {
		"type": "git",
		"url": "https://github.com/rainstormy/updraft.git"
	},
	"bin": {
		"updraft": "dist/cli/index.js"
	},
	"files": [
		"dist/cli/"
	],
	"type": "module",
	"imports": {
		"#promoters/*": "./src/promoters/*",
		"#programs/*": "./src/programs/*",
		"#types/*": "./src/types/*",
		"#utilities/*": "./src/utilities/*"
	},
	"dependencies": {
		"ansis": "catalog:",
		"fast-glob": "catalog:"
	},
	"devDependencies": {
		"@rainstormy/presets-web": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitest/ui": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
